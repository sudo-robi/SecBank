generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  TRANSFER_IN
  TRANSFER_OUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  name          String
  role          Role          @default(USER)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  accounts      Account[]
  auditLogs     AuditLog[]
  sentTransfers Transaction[] @relation("SentTransfers")
  sessions      Session[]
}

model Account {
  id        String        @id @default(uuid())
  userId    String
  balance   Decimal       @default(0) @db.Decimal(15, 2)
  currency  String        @default("USD")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user              User         @relation(fields: [userId], references: [id])
  incomingTransfers Transaction[] @relation("DestinationAccount")
  outgoingTransfers Transaction[] @relation("SourceAccount")

  @@index([userId])
}

model Transaction {
  id                String            @id @default(uuid())
  sourceAccountId   String
  destinationAccountId String
  amount            Decimal           @db.Decimal(15, 2)
  type              TransactionType
  status            TransactionStatus @default(PENDING)
  description       String?
  initiatedById     String
  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  sourceAccount      Account      @relation("SourceAccount", fields: [sourceAccountId], references: [id])
  destinationAccount Account      @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  initiatedBy        User         @relation("SentTransfers", fields: [initiatedById], references: [id])

  @@index([sourceAccountId])
  @@index([destinationAccountId])
  @@index([initiatedById])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([ipAddress])
}

model FailedLoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  userAgent String?
  reason    String   @default("INVALID_PASSWORD")
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
